# Copy to .env and fill in. Never commit .env.

# From https://opensky-network.org/my-opensky/account -> create an API client
# Try accounts in order; a 429 moves to the next available account. If all
# accounts are limited, workers sleep until an account's retry window opens.
OPENSKY_ACCOUNTS='[
  {"client_id": "client-id", "client_secret": "secret"}
]'

# Or keep the original single-account settings:
# OPENSKY_CLIENT_ID=your_client_id
# OPENSKY_CLIENT_SECRET=your_client_secret

# One worker (thread) is started per entry. Fields:
#   name      folder name under OUT_DIR (letters, digits, _ and - only)
#   lamin / lomin   south-west corner (latitude, longitude)
#   lamax / lomax   north-east corner (latitude, longitude)
#   interval  optional, seconds between polls (falls back to POLL_INTERVAL_SEC)
# Boxes may not cross the antimeridian (lon +/-180): split those in two.
BBOXES='[
  {"name": "test-1", "lamin": 43.309191, "lomin": -1.362305, "lamax": 49.639177, "lomax": 14.216309, "interval": 10}
]'
POLL_INTERVAL_SEC=90

# Each worker writes a Parquet file to OUT_DIR/<name>/ once its in-memory buffer
# reaches this size. This is the Arrow in-memory size; the file on disk is
# typically several times smaller after compression.
FLUSH_SIZE_MB=64

# Optional safety net: also flush if the oldest buffered data is this old
# (seconds), so a crash loses at most this much. 0 = size-only.
FLUSH_MAX_AGE_SEC=0

OUT_DIR=./data
PARQUET_COMPRESSION=zstd

# Standard account = 4000 credits/day (8000 for active feeders).
# Used only for the startup warning; this is the per-account budget.
DAILY_CREDIT_BUDGET=4000
