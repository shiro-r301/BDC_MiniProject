# Copy to .env and fill in. Never commit .env.
OPENSKY_ACCOUNTS='[
  {"client_id": "client-id", "client_secret": "secret"}
]'
BBOXES='[
  {"name": "test-1", "lamin": 43.309191, "lomin": -1.362305, "lamax": 49.639177, "lomax": 14.216309, "interval": 10}
]'
POLL_INTERVAL_SEC=90
FLUSH_SIZE_MB=64
FLUSH_MAX_AGE_SEC=0
OUT_DIR=./data
PARQUET_COMPRESSION=zstd
DAILY_CREDIT_BUDGET=4000

KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_INPUT_TOPIC=api_events
SPARK_KAFKA_PACKAGE=org.apache.spark:spark-sql-kafka-0-10_2.13:4.2.0
PROJECTION_REFERENCE_LATITUDE=19.0
PROJECTION_REFERENCE_LONGITUDE=76.0
KAFKA_STARTING_OFFSETS=earliest